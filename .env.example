# ─────────────────────────────────────────────────────────────
# KodaSoft POS — Docker Compose environment
# Copy this file to `.env` at the repository root and fill it in.
#   cp .env.example .env
# Note: this is NOT the same file as apps/api/.env.example
# ─────────────────────────────────────────────────────────────

# REQUIRED — used to sign access/refresh tokens. 32+ random characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-32-chars-min

# Public URL origin of the web app (used by CORS + payment success/return links).
# This is the DOMAIN origin — payment redirects append /app automatically.
CLIENT_URL=https://pos.koda-ye.com

# Public URL of the API (used by PayTabs/Moyasar webhook callbacks).
# In production this is your domain: https://yourdomain.com
API_URL=http://localhost

# Port the WEB app is exposed on the host (we use 8080 so Nginx can safely
# use port 80 for SSL). Host-level nginx proxies 80 -> this port.
PORT=8080

# ── Marketing site (apps/site) ─────────────────────────────────
# The site owns the domain root (e.g. https://pos.koda-ye.com). The POS web app
# lives under /app on the same domain.
# Canonical URL of the marketing site (used by Astro for SEO/sitemap).
SITE_URL=https://pos.koda-ye.com
# Where the site's "Login / Get started" buttons point: the POS app under /app.
PUBLIC_APP_URL=https://pos.koda-ye.com/app
# Host port the site container listens on. Host-level nginx proxies the domain
# root (port 80) to this port. NOT a separate public URL.
SITE_PORT=8081

# ── Database (Postgres) ────────────────────────────────────────
# Only use A-Z a-z 0-9 and -_ characters. If the password contains
# characters like @ : / # ? they must be URL-encoded in DATABASE_URL,
# which docker-compose builds for you — safest to avoid them entirely.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Write_A_Very_Strong_Password_2026
POSTGRES_DB=casheer_db

# ── Billing / payments ─────────────────────────────────────────
# sandbox | live
PAYMENT_MODE=sandbox
# stripe | paytabs | moyasar
PAYMENT_PROVIDER=stripe

# Stripe (only needed in live mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayTabs (only needed in live mode)
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=SAU

# Moyasar (only needed in live mode)
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# ── ZATCA at-rest encryption (optional) ────────────────────────
# Separate encryption key for ZATCA secrets. If omitted, JWT_SECRET is used.
# Generate one with:  openssl rand -base64 32
ZATCA_ENC_KEY=
