---
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { APP_URL } from '../lib/app';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const path = Astro.url.pathname;
const base = path.startsWith(`/${lang}`) ? path.slice(`/${lang}`.length) : path;
const isHome = base === '' || base === '/';

const other: Locale = lang === 'en' ? 'ar' : 'en';

const links = [
  { label: t(lang, 'navFeatures'), href: isHome ? '#features' : `/${lang}#features` },
  { label: t(lang, 'navPricing'), href: `/${lang}/pricing` },
  { label: t(lang, 'navFaq'), href: isHome ? '#faq' : `/${lang}#faq` },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <!-- Brand -->
    <a href={`/${lang}`} class="flex items-center gap-2.5">
      <img src="/logo_transparent.png" alt="KodaSoft-POS" class="h-9 w-9 object-contain" />
      <span class="text-base font-extrabold tracking-tight text-slate-900">
        KodaSoft-<span class="text-cyan-500">POS</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-bold text-slate-600 transition-colors hover:text-cyan-600"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`/${other}${base === '/' ? '' : base}`}
        class="hidden sm:flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 transition-colors hover:border-cyan-300 hover:text-cyan-600"
      >
        {other === 'ar' ? 'العربية' : 'English'}
      </a>
      <a
        href={`${APP_URL}/login`}
        class="hidden md:block text-sm font-bold text-slate-700 transition-colors hover:text-cyan-600"
      >
        {t(lang, 'login')}
      </a>
      <a
        href={`${APP_URL}/register`}
        class="rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-md shadow-cyan-500/25 transition-all hover:from-cyan-600 hover:to-blue-700"
      >
        {t(lang, 'startFree')}
      </a>
    </div>
  </nav>

  <!-- Mobile nav row -->
  <div class="md:hidden border-t border-slate-100 px-4 py-2.5 flex items-center gap-4" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <a
      href={`/${other}${base === '/' ? '' : base}`}
      class="flex items-center gap-1.5 text-xs font-bold text-slate-600"
    >
      {other === 'ar' ? 'العربية' : 'English'}
    </a>
    {links.map((link) => (
      <a href={link.href} class="text-xs font-bold text-slate-600">
        {link.label}
      </a>
    ))}
  </div>
</header>
