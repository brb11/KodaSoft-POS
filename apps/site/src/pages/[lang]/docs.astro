---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { t, locales, type Locale } from '../../lib/i18n';
import { CONTACT_EMAIL, CONTACT_WHATSAPP_LINK } from '../../lib/app';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const rtl = lang === 'ar';

const sections = [
  { id: 'getting-started', key: 'gettingStarted' },
  { id: 'dashboard', key: 'dashboard' },
  { id: 'products', key: 'products' },
  { id: 'sales', key: 'sales' },
  { id: 'customers', key: 'customers' },
  { id: 'purchases', key: 'purchases' },
  { id: 'expenses', key: 'expenses' },
  { id: 'branches', key: 'branches' },
  { id: 'shifts', key: 'shifts' },
  { id: 'users', key: 'users' },
  { id: 'reports', key: 'reports' },
  { id: 'offline', key: 'offline' },
  { id: 'zatca', key: 'zatca' },
  { id: 'settings', key: 'settings' },
  { id: 'help', key: 'help' },
];
const toc = sections.map((s) => ({ id: s.id, label: t(lang, `docs.${s.key}.title`) }));

const gettingStartedSteps: { num: number; title: string; body: string }[] = [1, 2, 3, 4].map((n) => ({
  num: n,
  title: t(lang, `docs.gettingStarted.s${n}t`),
  body: t(lang, `docs.gettingStarted.s${n}d`),
}));

// Sections rendered as a simple card with one or more paragraphs.
const simpleSections = sections.slice(1);
---

<SiteLayout
  lang={lang}
  title={lang === 'ar' ? `دليل الاستخدام | KodaSoft-POS` : `User Guide | KodaSoft-POS`}
  description={t(lang, 'docs.subtitle')}
>
  <style is:global>
    .doc-lb-backdrop {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(15, 23, 42, 0.9);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .doc-lb-stage {
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      max-width: 96vw;
      max-height: 88vh;
    }
    .doc-lb-img {
      max-width: 96vw;
      max-height: 82vh;
      object-fit: contain;
      border-radius: 12px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
      user-select: none;
      transition: transform 0.15s ease;
    }
    .doc-lb-caption {
      color: #cde;
      font-size: 13px;
      font-weight: 700;
      text-align: center;
    }
    .doc-lb-toolbar {
      position: absolute;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 8px;
      background: #fff;
      border-radius: 14px;
      padding: 8px 10px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }
    .doc-lb-btn {
      min-width: 34px;
      height: 34px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #0f172a;
      border-radius: 9px;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .doc-lb-btn:hover {
      background: #0ea5e9;
      border-color: #0ea5e9;
      color: #fff;
    }
    .doc-lb-pct {
      min-width: 48px;
      text-align: center;
      font-size: 12px;
      font-weight: 800;
      color: #475569;
    }
  </style>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-cyan-50 via-white to-slate-50" />
    <div class="hero-grid absolute inset-0" />
    <div class="relative mx-auto max-w-7xl px-4 pb-10 pt-20 text-center sm:px-6 lg:px-8" dir={rtl ? 'rtl' : 'ltr'}>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-cyan-600">
        <Icon name="globe" class="h-3.5 w-3.5" />
        {t(lang, 'docs.title')}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">{t(lang, 'docs.title')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base">{t(lang, 'docs.subtitle')}</p>
    </div>
  </section>

  <!-- Content -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8" dir={rtl ? 'rtl' : 'ltr'}>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[240px_1fr]">
      <!-- TOC -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <p class="mb-3 text-xs font-extrabold uppercase tracking-wider text-slate-400">{t(lang, 'docs.toc')}</p>
        <nav class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:gap-0 lg:overflow-visible lg:pb-0">
          {toc.map((item, i) => (
            <a
              href={`#${item.id}`}
              class="shrink-0 rounded-xl border border-slate-200/80 bg-white px-3 py-2 text-xs font-bold text-slate-600 transition-colors hover:border-cyan-300 hover:text-cyan-600 lg:rounded-none lg:border-0 lg:bg-transparent lg:px-3 lg:py-2"
            >
              <span class="me-1.5 inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-extrabold text-slate-400 lg:me-2">
                {i + 1}
              </span>
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Body -->
      <div class="min-w-0 space-y-8">
        <!-- Getting started: numbered guide -->
        <section id="getting-started" class="scroll-mt-24 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 text-white">
              <Icon name="zap" class="h-5 w-5" />
            </span>
            <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">{t(lang, 'docs.gettingStarted.title')}</h2>
          </div>
          <ol class="mt-8 space-y-8">
            {gettingStartedSteps.map((step) => (
              <li class="relative ps-12">
                <span class="absolute start-0 top-0 flex h-8 w-8 items-center justify-center rounded-full bg-cyan-100 text-sm font-extrabold text-cyan-600">
                  {step.num}
                </span>
                <h3 class="text-base font-extrabold text-slate-900">{step.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-500">{step.body}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- Simple sections -->
        {simpleSections.map((s) => (
          <section id={s.id} class="scroll-mt-24 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
            <h2 class="text-xl font-extrabold tracking-tight text-slate-900">{t(lang, `docs.${s.key}.title`)}</h2>
            {['p1', 'p2', 'p3', 'p4', 'p5'].map((key) => {
              const label = t(lang, `docs.${s.key}.${key}`);
              if (label === `docs.${s.key}.${key}`) return null;
              return (
                <p class="mt-3 text-sm leading-relaxed text-slate-500">{label}</p>
              );
            })}
          </section>
        ))}

        <!-- Help CTA -->
        <section id="help" class="scroll-mt-24 rounded-3xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-700 p-8 text-center shadow-2xl shadow-blue-500/20 sm:p-10">
          <Icon name="sparkles" class="mx-auto h-8 w-8 text-cyan-100" />
          <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-white">{t(lang, 'docs.help.title')}</h2>
          <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-cyan-100">{t(lang, 'docs.help.p1')}</p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-extrabold text-blue-700 shadow-lg transition-transform hover:scale-105"
            >
              {CONTACT_EMAIL}
            </a>
            <a
              href={CONTACT_WHATSAPP_LINK}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-6 py-3 text-sm font-extrabold text-white shadow-lg transition-transform hover:scale-105"
            >
              <Icon name="whatsapp" class="h-4 w-4" filled />
              {t(lang, 'docs.help.whatsapp')}
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Lightbox labels fed by the i18n dictionary for the inline script -->
  <div
    id="doc-lb-labels"
    data-zoom-in={t(lang, 'docs.zoomIn')}
    data-zoom-out={t(lang, 'docs.zoomOut')}
    data-reset={t(lang, 'docs.resetZoom')}
    data-close={t(lang, 'docs.closeZoom')}
    hidden
  ></div>

  <script>
    (() => {
      const labels = document.getElementById('doc-lb-labels')!;
      const texts = {
        zoomIn: labels.dataset.zoomIn ?? '',
        zoomOut: labels.dataset.zoomOut ?? '',
        reset: labels.dataset.reset ?? '',
        close: labels.dataset.close ?? '',
      };
      let scale = 1;
      const overlay = document.createElement('div');
      overlay.className = 'doc-lb-backdrop';
      overlay.style.display = 'none';
      overlay.innerHTML = `
        <figure class="doc-lb-stage">
          <img class="doc-lb-img" alt="" />
          <figcaption class="doc-lb-caption"></figcaption>
        </figure>`;
      const mkBtn = (label: string, title: string, onClick: () => void) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.title = title;
        b.className = 'doc-lb-btn';
        b.addEventListener('click', onClick);
        return b;
      };
      const pct = document.createElement('span');
      pct.className = 'doc-lb-pct';
      const controls = document.createElement('div');
      controls.className = 'doc-lb-toolbar';
      const zoomOut = mkBtn('−', texts.zoomOut, () => setScale(scale / 1.25));
      const zoomIn = mkBtn('+', texts.zoomIn, () => setScale(scale * 1.25));
      const resetBtn = mkBtn('1:1', texts.reset, () => setScale(1));
      const closeBtn = mkBtn('✕', texts.close, close);
      controls.append(zoomOut, zoomIn, resetBtn, pct, closeBtn);
      overlay.append(controls);
      document.body.appendChild(overlay);

      const imgEl = overlay.querySelector('.doc-lb-img') as HTMLImageElement;
      function setScale(next: number) {
        scale = Math.min(8, Math.max(1, next));
        imgEl.style.transform = `scale(${scale})`;
        pct.textContent = `${Math.round(scale * 100)}%`;
      }
      function open(src: string, alt: string) {
        imgEl.src = src;
        imgEl.alt = alt;
        overlay.querySelector('.doc-lb-caption')!.textContent = alt;
        scale = 1;
        imgEl.style.transform = 'scale(1)';
        pct.textContent = '100%';
        overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
      function close() {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
      }

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) close();
      });
      overlay.addEventListener(
        'wheel',
        (e) => {
          if (overlay.style.display === 'none') return;
          e.preventDefault();
          setScale(e.deltaY < 0 ? scale + 0.25 : scale - 0.25);
        },
        { passive: false }
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const img = target.closest('figure > img');
        if (img && !img.closest('.doc-lb-backdrop')) {
          const full = img as HTMLImageElement;
          open(full.currentSrc || full.src, full.alt);
        }
      });
    })();
  </script>
</SiteLayout>