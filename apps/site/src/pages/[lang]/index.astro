---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PricingCard from '../../components/PricingCard.astro';
import Icon from '../../components/Icon.astro';
import { t, locales, type Locale } from '../../lib/i18n';
import { APP_URL } from '../../lib/app';
import { plans } from '../../data/plans';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const features = [
  { icon: 'shield' as const, title: 'featZatca', desc: 'featZatcaDesc' },
  { icon: 'wifi-off' as const, title: 'featOffline', desc: 'featOfflineDesc' },
  { icon: 'building' as const, title: 'featMultiBranch', desc: 'featMultiBranchDesc' },
  { icon: 'chart' as const, title: 'featReports', desc: 'featReportsDesc' },
  { icon: 'users' as const, title: 'featUsers', desc: 'featUsersDesc' },
  { icon: 'package' as const, title: 'featInventory', desc: 'featInventoryDesc' },
];

const stats = [
  { value: '10k+', label: 'statOrders' },
  { value: '250k+', label: 'statProducts' },
  { value: '120+', label: 'statBranches' },
  { value: '1.5k+', label: 'statUsers' },
];

const faqs = [
  { q: 'faq1q', a: 'faq1a' },
  { q: 'faq2q', a: 'faq2a' },
  { q: 'faq3q', a: 'faq3a' },
  { q: 'faq4q', a: 'faq4a' },
  { q: 'faq5q', a: 'faq5a' },
];
---

<SiteLayout
  lang={lang}
  title={lang === 'ar' ? 'KodaSoft-POS | نقطة بيع سحابية وفوترة إلكترونية متوافقة مع زاتكا' : 'KodaSoft-POS | Cloud POS & ZATCA-ready e-Invoicing'}
  description={t(lang, 'heroSubtitle')}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-cyan-50 via-white to-slate-50" />
    <div class="absolute inset-0 hero-grid" />
    <div class="absolute -top-32 start-1/3 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl" />
    <div class="absolute top-20 end-10 h-56 w-56 rounded-full bg-blue-500/10 blur-3xl" />

    <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-20 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-white/70 px-4 py-1.5 text-xs font-bold text-cyan-700 shadow-sm backdrop-blur">
        <Icon name="sparkles" class="h-3.5 w-3.5" />
        {t(lang, 'heroBadge')}
      </span>

      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        {t(lang, 'heroTitle1')}{' '}
        <span class="bg-gradient-to-r from-cyan-500 to-blue-600 bg-clip-text text-transparent">
          {t(lang, 'heroTitleAccent')}
        </span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        {t(lang, 'heroSubtitle')}
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={`${APP_URL}/register`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-8 py-4 text-sm font-bold text-white shadow-xl shadow-cyan-500/30 transition-all hover:from-cyan-600 hover:to-blue-700 sm:w-auto"
        >
          {t(lang, 'ctaStart')}
          <Icon name="arrow" class="h-4 w-4 rotate-180 rtl:rotate-0" />
        </a>
        <a
          href={`/${lang}/pricing`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-8 py-4 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:border-cyan-300 hover:text-cyan-600 sm:w-auto"
        >
          {t(lang, 'ctaPricing')}
        </a>
      </div>

      <p class="mt-5 text-xs font-semibold text-slate-400">{t(lang, 'trustLine')}</p>

      <!-- Stats -->
      <div class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
        {stats.map((s) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 shadow-sm backdrop-blur">
            <p class="text-2xl font-extrabold text-slate-900">{s.value}</p>
            <p class="mt-1 text-[11px] font-bold text-slate-400">{t(lang, s.label)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{t(lang, 'featuresTitle')}</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-slate-500 sm:text-base">{t(lang, 'featuresSubtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-sm transition-all hover:-translate-y-1 hover:border-cyan-200 hover:shadow-lg">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 text-white shadow-md shadow-cyan-500/20 transition-transform group-hover:scale-110">
            <Icon name={f.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-5 text-base font-extrabold text-slate-900">{t(lang, f.title)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">{t(lang, f.desc)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="bg-slate-900 py-20" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{t(lang, 'pricingTitle')}</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-slate-400 sm:text-base">{t(lang, 'pricingSubtitle')}</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((plan) => <PricingCard plan={plan} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{t(lang, 'faqTitle')}</h2>

    <div class="mt-10 space-y-3">
      {faqs.map((faq, i) => (
        <details class="group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm open:border-cyan-200">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-extrabold text-slate-900">
            <span class="flex items-center gap-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cyan-50 text-xs font-extrabold text-cyan-600">
                {i + 1}
              </span>
              {t(lang, faq.q)}
            </span>
            <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-4 ps-10 text-sm leading-relaxed text-slate-500">{t(lang, faq.a)}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-700 px-8 py-14 text-center shadow-2xl shadow-blue-500/20">
      <div class="absolute inset-0 hero-grid opacity-40" />
      <div class="relative">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{t(lang, 'ctaTitle')}</h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-cyan-100 sm:text-base">{t(lang, 'ctaSubtitle')}</p>
        <a
          href={`${APP_URL}/register`}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-white px-8 py-4 text-sm font-extrabold text-blue-700 shadow-lg transition-transform hover:scale-105"
        >
          {t(lang, 'ctaButton')}
          <Icon name="arrow" class="h-4 w-4 rotate-180 rtl:rotate-0" />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
